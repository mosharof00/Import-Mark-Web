# ============================================================
# Environment Variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored; never commit real keys.
#
# Branding (logo, name, tagline) is NOT set here.
# Edit `src/config/brand.ts` and replace files in `public/`.
# See docs/branding.md.
# ============================================================

# --- Public (safe to expose to the browser) ---------------------------------
# Supabase Dashboard > Project Settings > Data API  ->  Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Dashboard > Project Settings > API Keys  ->  publishable / anon key
# (a value starting with `sb_publishable_...`, or the legacy anon JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this app. Used to build auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (NEVER prefix with NEXT_PUBLIC, never expose) ---------------
# Supabase Dashboard > Project Settings > API Keys  ->  service_role (SECRET)
# Bypasses Row Level Security. Used only by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Project ref id (the subdomain of your Supabase URL). Used by `npm run gen:types`.
SUPABASE_PROJECT_ID=
